pipeline {
    agent{
        label 'worker'
    }
    tools{
        maven 'mvn'
    }
    environment {
        my_aws = credentials('aws_cred')
    }

    stages {
        stage ('checkout'){
            steps {
                git 'https://github.com/Abhisharma078/student-application-.git'
            }
             post {
                success {
                    echo "checkout has been completed"                 
                }
             }
          } 
        stage ('build'){
            steps{
                sh '''
                mvn clean package
                ''' 
            }
             post{
                 success{
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
              }
        }    

            stage ('Artifacts to s3'){
                steps {
                    sh '''
                       sudo apt install awscli -y
                      aws s3 cp target/*.war s3://abhiclpid.online/Artifacts/student
                      '''
                }
            }      
     }  
 }
   
