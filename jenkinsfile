pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'mvn'
    }

    stages{

        stage('Checkout'){
            steps{
                git 'https://github.com/mayurpandit25/student-management.git'
                echo "Clonning is Successful"
            }
        }

        stage('Build') {
            steps {
                sh '''
                  mvn clean package
                '''
            }
        }
    }
}